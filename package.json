{
  "name": "portfolio-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "projects/*/app"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p apps/portfolio/tsconfig.json --noEmit && npm run typecheck --workspace @portfolio/traceshelf && npm run typecheck --workspace @portfolio/quietslot",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "dev": "npm run dev --workspace @portfolio/site --",
    "build": "node scripts/build.mjs",
    "preview": "npm run preview --workspace @portfolio/site --",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:traceshelf": "npm run dev --workspace @portfolio/traceshelf --",
    "dev:quietslot": "npm run dev --workspace @portfolio/quietslot --"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "ical.js": "2.2.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
